 "components": [
  {
   "name": "Header Tab",
   "kind": "nav",
   "refersTo": "tab",
   "description": "Underlined uppercase tab in the header strip.",
   "html": "<nav class=\"ds-strip\"><span class=\"ds-mark\">ZENTOP</span><a class=\"ds-tab ds-on\">PROCESSES</a><a class=\"ds-tab\">RESOURCES</a></nav>",
   "css": ".ds-strip{background:#010409;border-bottom:1px solid #262C36;display:flex;align-items:center;gap:4px;padding:0 20px;height:48px;font-family:Inter,sans-serif} .ds-mark{color:#E6EDF3;font-weight:800;font-size:14px;letter-spacing:3px;margin-right:24px} .ds-tab{color:#9198A1;font-size:12px;font-weight:600;letter-spacing:1px;padding:15px 14px 13px;border-bottom:2px solid transparent;cursor:pointer} .ds-tab:hover{color:#E6EDF3} .ds-tab.ds-on{color:#E6EDF3;border-bottom-color:#A78BFA}"
  },
  {
   "name": "Control",
   "kind": "input",
   "refersTo": "control",
   "description": "Shared recipe for entries, combos and buttons.",
   "html": "<input class=\"ds-control\" placeholder=\"Filter by process name...\">",
   "css": ".ds-control{background:#161B22;color:#E6EDF3;border:1px solid #262C36;border-radius:4px;padding:3px 10px;min-height:24px;font:13px Inter,sans-serif} .ds-control:focus-visible{outline:none;border-color:#A78BFA}"
  },
  {
   "name": "Load-band Row",
   "kind": "custom",
   "refersTo": "table-cell",
   "description": "Idle / normal / hot figures in one table row.",
   "html": "<table class=\"ds-tt\"><tr><td>yes</td><td class=\"ds-hot\">99.0%</td><td class=\"ds-idle\">1.6MB</td></tr><tr><td>kthreadd</td><td class=\"ds-idle\">0.0%</td><td class=\"ds-idle\">0.0B</td></tr></table>",
   "css": ".ds-tt{background:#0D1117;color:#E6EDF3;font:13px Inter,sans-serif;font-variant-numeric:tabular-nums;border-collapse:collapse} .ds-tt td{padding:3px 8px;text-align:right} .ds-tt td:first-child{text-align:left} .ds-hot{color:#C3ADFF;font-weight:700} .ds-idle{color:#7D8590}"
  },
  {
   "name": "Meter",
   "kind": "custom",
   "refersTo": "meter",
   "description": "Thin 6px bar for cores, memory and disk use.",
   "html": "<div class=\"ds-meter\"><div style=\"width:62%\"></div></div>",
   "css": ".ds-meter{background:#161B22;height:6px;border-radius:2px;width:240px} .ds-meter>div{background:#8B5CF6;height:6px;border-radius:2px}"
  }
 ],
 "narrative": {
  "northStar": "The Departure Board",
  "overview": "zentop reads like a Japanese railway timetable: tabular figures, hairline rules, a one-line header strip, and load shown through type. Six themes fill one set of roles, so identity changes and behaviour never does.",
  "keyCharacteristics": [
   "Tabular figures everywhere a number appears (Inter tnum).",
   "Load bands: values are typeset idle, normal or hot instead of being uniformly grey.",
   "One-line header strip with underlined tabs instead of a big title and pills.",
   "Hairline 1px rules; no shadows, gradients or transitions.",
   "The app reads the colours from the theme CSS (.zt-c-<role>), so Cairo graphs follow the theme with no hard-coded palettes."
  ],
  "rules": [
   {
    "name": "The Load Band Rule",
    "section": "colors",
    "body": "CPU below 0.5% and memory below 0.5% use idle ink; CPU from 20% and memory from 5% use hot ink at weight 700. Zero disk rates use idle ink."
   },
   {
    "name": "The Role Rule",
    "section": "colors",
    "body": "Code never names a hex value; the code asks the stylesheet for a role."
   },
   {
    "name": "The Tracking Rule",
    "section": "typography",
    "body": "Letter-spacing only on single-line uppercase strings in fixed-height containers."
   }
  ],
  "dos": [
   "Do add a theme by writing one CSS file that fills every role, .zt-c-* included.",
   "Do keep numbers in tabular figures and let weight and colour carry load.",
   "Do update widgets by setting text or values; build them once."
  ],
  "donts": [
   "Don't add transitions, box-shadow, gradients or text-shadow; they cost frame time.",
   "Don't hard-code colours in the code.",
   "Don't use letter-spacing on free-standing labels that contain spaces.",
   "Don't use per-cell cell_data_func on the process table."
  ]
 }
}